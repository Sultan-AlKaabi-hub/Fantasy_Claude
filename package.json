{
  "name": "gloomfall",
  "version": "1.0.0",
  "private": true,
  "description": "Gloomfall: The Pilgrim's Road — a dark, colourful Metroidvania PWA (vanilla JS + Canvas, zero runtime dependencies).",
  "type": "module",
  "scripts": {
    "start": "node tools/dev-server.mjs 8080",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/**/*.test.mjs\"",
    "icons": "python tools/gen-icons.py",
    "lighthouse": "npx --yes @lhci/cli@0.14 autorun --config=lighthouserc.json",
    "e2e": "npx --yes playwright@1.47 test tests/e2e",
    "check": "npm test && node tools/check-precache.mjs"
  },
  "engines": { "node": ">=22" },
  "license": "MIT"
}
